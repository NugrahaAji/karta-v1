    # ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
DB_NAME=Database

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Redis (for Bull queue) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── SMTP (Email / OTP) ──────────────────────────────────────────────────────
# Gunakan Gmail + App Password (gratis, tanpa batas sandbox):
# 1. Aktifkan 2-Step Verification di Google Account
# 2. Buat App Password di https://myaccount.google.com/apppasswords
# 3. Isi SMTP_USER dengan email Gmail, SMTP_PASS dengan App Password (16 karakter)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── File Storage (S3 / Cloudinary) ──────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
